{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkframe",
  "version": "0.1.0",
  "identifier": "com.inkframe.app",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inkframe",
        "width": 960,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 520,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        },
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}