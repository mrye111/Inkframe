<Window x:Class="ScreenRecorder.UI.Views.FloatingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScreenRecorder.UI.ViewModels"
        xmlns:conv="clr-namespace:ScreenRecorder.UI.Converters"
        Title="Inkframe 录制中"
        Height="56" Width="400"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Background="{x:Null}"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource InkFontFamily}"
        MouseLeftButtonDown="OnDragStart">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/GlassTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Glass 3 胶囊：Acrylic 由 DWM 透出；降级时此半透明底也成立（调研铁律） -->
    <Border CornerRadius="28" Padding="20,7,7,7"
            BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C012141A" Offset="0"/>
                <GradientStop Color="#A812141A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.5" BlurRadius="32" ShadowDepth="8"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 录制红点（§32：呼吸动画仅 Opacity——守 GPU 预算） -->
            <Border Grid.Column="0" Width="11" Height="11" CornerRadius="5.5" VerticalAlignment="Center"
                    x:Name="RecDot">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource InkRecordingRed}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Background" Value="#FFB340"/>
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard x:Name="BreathStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.8"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>

            <!-- 时长（§33：Medium + 等宽数字） -->
            <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                       FontSize="16" FontWeight="Medium"
                       Foreground="{DynamicResource InkTextPrimary}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>

            <Border Grid.Column="2" Width="1" Height="22" Margin="10,0,0,0"
                    Background="#1AFFFFFF" VerticalAlignment="Center"/>

            <!-- 麦克风 + VU 音量柱（§35） -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Path Data="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z M19 10v2a7 7 0 0 1-14 0v-2 M12 19v3"
                      Stroke="{DynamicResource InkTextPrimary}" StrokeThickness="1.8"
                      Fill="{x:Null}" Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding VuBars}" Margin="6,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="3" Height="{Binding}" Margin="1.5,0"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource InkSoftGreen}" CornerRadius="1.5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Column="4" Width="1" Height="22" Margin="10,0,0,0"
                    Background="#1AFFFFFF" VerticalAlignment="Center"/>

            <!-- 暂停/继续（Path 双图标按态切换） -->
            <Button Grid.Column="5" Command="{Binding TogglePauseCommand}"
                    Style="{StaticResource FloatBarButton}" Margin="10,0,0,0">
                <Grid Width="14" Height="14">
                    <Path Data="M6 4h4v16H6z M14 4h4v16h-4z" Fill="{DynamicResource InkTextPrimary}"
                          Stretch="Uniform"
                          Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                    <Path Data="M7 4l13 8-13 8z" Fill="#FFB340" Stretch="Uniform"
                          Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </Button>
            <!-- 停止（录制红圆钮） -->
            <Button Grid.Column="6" Command="{Binding StopCommand}"
                    Style="{StaticResource FloatBarStopButton}" Margin="8,0,0,0">
                <Path Data="M5 5h14v14H5z" Fill="#FFF" Stretch="Uniform" Width="12" Height="12"/>
            </Button>
        </Grid>
    </Border>
</Window>