<Window x:Class="ScreenRecorder.UI.Views.RegionSelectorOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="#01000000" Topmost="True" Cursor="Cross"
        WindowState="Maximized"
        Title="选择录制区域"
        KeyDown="OnKeyDown">
    <!--
      例外说明（research 硬约束仅禁主窗体 AllowsTransparency）：
      区域选择层是录制前的瞬态交互窗， AllowsTransparency 分层窗在此成立——
      录制未开始，无 GPU 争用；交互结束即销毁。
    -->
    <Grid x:Name="Root"
          MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
        <!-- 暗化遮罩 -->
        <Rectangle Fill="#66000000"/>

        <!-- 选区橡皮筋 -->
        <Border x:Name="RubberBand" Visibility="Collapsed"
                BorderBrush="#FF453A" BorderThickness="1.5"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Background>
                <SolidColorBrush Color="#22FF453A"/>
            </Border.Background>
        </Border>

        <!-- 提示 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0"
                CornerRadius="999" Padding="20,10" Background="#CC101218">
            <TextBlock Text="拖拽框选录制区域 · Esc 取消" Foreground="#F2F2F5" FontSize="14.5"/>
        </Border>

        <!-- 尺寸标签 -->
        <Border x:Name="SizeLabel" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="8" Padding="8,4" Background="#CC101218">
            <TextBlock x:Name="SizeText" Foreground="#F2F2F5" FontSize="12.5"/>
        </Border>
    </Grid>
</Window>
