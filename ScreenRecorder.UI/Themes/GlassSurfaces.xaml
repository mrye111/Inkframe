<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ScreenRecorder.UI.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GlassTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <conv:ModeToBoolConverter x:Key="ModeToBoolConverter"/>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    <!-- 玻璃边缘画笔：顶部较亮 → 中段极弱 → 底部略暗（规范 §8，禁 1px 均亮边框） -->
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.35"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.7"/>
        <GradientStop Color="#3D000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- 顶部柔光（规范 §7 Glass 2：顶部柔光 + 内部亮度渐变） -->
    <LinearGradientBrush x:Key="GlassTopGlowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1FFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Glass 1：普通交互区域（侧栏/顶栏/设置区）===== -->
    <Style x:Key="GlassPanel1" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#0FFFFFFF"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Glass 2：主要功能卡（三大录制模式卡）===== -->
    <!-- 明显景深 = 边缘渐变 + 顶部柔光 + 内部亮度渐变 + 投影 -->
    <Style x:Key="GlassCard2" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="{StaticResource RadiusModeCard}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource GlassEdgeBrush}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#21FFFFFF" Offset="0"/>
                                <GradientStop Color="#0DFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="24"
                                              ShadowDepth="6" RenderingBias="Quality"/>
                        </Border.Effect>
                        <Grid>
                            <!-- 顶部柔光带：只染上半部，Render 层静态画笔零重绘 -->
                            <Border VerticalAlignment="Top" Height="56"
                                    CornerRadius="{StaticResource RadiusModeCard}"
                                    Background="{StaticResource GlassTopGlowBrush}"/>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 录制模式卡（§27 三大模式；选中态软蓝描边提亮）===== -->
    <Style x:Key="ModeCardStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Height" Value="180"/>
        <Setter Property="FontSize" Value="{StaticResource FontSection}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkTextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource GlassCard2}"/>
                        </ContentControl.Style>
                        <Grid>
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Grid>
                        <ContentControl.Resources>
                            <Style x:Key="HitArea" TargetType="ContentControl"/>
                        </ContentControl.Resources>
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkSoftBlue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 录制主按钮（§20-21：玻璃胶囊 → Stop 平滑变化）===== -->
    <Style x:Key="RecordPillButton" TargetType="Button">
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkTextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="{StaticResource RadiusPrimaryButton}"
                            BorderThickness="1" BorderBrush="{StaticResource GlassEdgeBrush}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2EFFFFFF" Offset="0"/>
                                <GradientStop Color="#14FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- hover：玻璃亮度提升（§20） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#42FFFFFF" Offset="0"/>
                                        <GradientStop Color="#21FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- 点击：轻微压缩（§21，仅 Transform——GPU 预算规则） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>