<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Private.CoreLib">

    <!-- ===== 背景层级（规范 §10）===== -->
    <Color x:Key="InkBackgroundColor0">#090A0D</Color>
    <Color x:Key="InkBackgroundColor1">#101218</Color>
    <Color x:Key="InkBackgroundColor2">#151821</Color>
    <SolidColorBrush x:Key="InkBackground0" Color="{StaticResource InkBackgroundColor0}"/>
    <SolidColorBrush x:Key="InkBackground1" Color="{StaticResource InkBackgroundColor1}"/>
    <SolidColorBrush x:Key="InkBackground2" Color="{StaticResource InkBackgroundColor2}"/>

    <!-- ===== 品牌状态色（规范 §18-19：95% 黑白灰玻璃，状态才用色）===== -->
    <Color x:Key="InkRecordingRedColor">#FF453A</Color>
    <SolidColorBrush x:Key="InkRecordingRed" Color="{StaticResource InkRecordingRedColor}"/>
    <SolidColorBrush x:Key="InkSoftBlue" Color="#5E8CE6"/>
    <SolidColorBrush x:Key="InkSoftGreen" Color="#63C28C"/>

    <!-- ===== 文字（层级对比 > 粗体，规范 §15）===== -->
    <SolidColorBrush x:Key="InkTextPrimary" Color="#F2F2F5"/>
    <SolidColorBrush x:Key="InkTextSecondary" Color="#9A9AA5"/>
    <SolidColorBrush x:Key="InkTextTertiary" Color="#62626C"/>

    <!-- ===== 圆角体系（规范 §12：精密工业产品圆润感，禁全组件同圆角）===== -->
    <CornerRadius x:Key="RadiusTiny">8</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">12</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">16</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">22</CornerRadius>
    <CornerRadius x:Key="RadiusXL">28</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">30</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <!-- 语义槽位：录制模式卡 22-26 / 主按钮 20-24 / 悬浮条 999 -->
    <CornerRadius x:Key="RadiusModeCard">24</CornerRadius>
    <CornerRadius x:Key="RadiusPrimaryButton">22</CornerRadius>

    <!-- ===== 间距（规范 §13：4pt 网格，禁随机值）===== -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="Space40">40</sys:Double>
    <sys:Double x:Key="Space48">48</sys:Double>
    <sys:Double x:Key="Space64">64</sys:Double>

    <!-- ===== 字体（规范 §14：中文优先 Segoe UI Variable / Microsoft YaHei UI）===== -->
    <FontFamily x:Key="InkFontFamily">Segoe UI Variable, Microsoft YaHei UI</FontFamily>

    <!-- ===== Typography 层级（规范 §16）===== -->
    <sys:Double x:Key="FontHero">34</sys:Double>
    <sys:Double x:Key="FontTitle">24</sys:Double>
    <sys:Double x:Key="FontSection">18</sys:Double>
    <sys:Double x:Key="FontBody">14.5</sys:Double>
    <sys:Double x:Key="FontSecondary">12.5</sys:Double>
    <sys:Double x:Key="FontMicro">11</sys:Double>
</ResourceDictionary>
